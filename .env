# ── Application ───────────────────────────────────────────────────
APP_NAME=LiDAR3D
APP_ENV=production
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
DEBUG=false
LOG_LEVEL=INFO

# ── First Admin User (used by deploy_ubuntu.sh) ───────────────────
ADMIN_EMAIL=admin@example.com

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=lidar3d_secret
DATABASE_URL=postgresql+asyncpg://lidar3d:lidar3d_secret@postgres:5432/lidar3d

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=9fK2xL7qP8vN4sT1mW6zR3aH5yU0cD8eJ2bQ7gX4kM1pL9oV6nF
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Storage ───────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
OUTPUT_DIR=/data/output
MAX_UPLOAD_SIZE_GB=10
CHUNK_SIZE_MB=64

# ── Cesium ────────────────────────────────────────────────────────
